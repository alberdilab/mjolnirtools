#%Module1.0

proc ModulesHelp { } {
    puts stderr "mjolnirtools provides beginner-friendly shortcuts for common Mjolnir HPC workflows."
    puts stderr "Commands include: mt slurm interactive, mt slurm, mt list, mt screen, mt version, and mt help."
}

module-whatis "Beginner-friendly shortcuts for common Mjolnir HPC workflows"

set root /opt/mjolnirtools/1.0.0
prepend-path PATH $root/bin
